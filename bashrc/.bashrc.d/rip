#! /bin/bash
rip() { # usage: rip [--all] "Movie Name (Year)" [min_seconds]
  local all=0 pick=0 disc model label drive choice
  while [[ $1 == -* ]]; do
    case "$1" in
    --all | -a)
      all=1
      shift
      ;;
    --disc | -d)
      pick=1
      shift
      ;;
    *)
      echo "rip: unknown option $1"
      return 1
      ;;
    esac
  done
  # check if $1 is empty
  if [[ -z $1 ]]; then
    echo 'Usage: rip [--all|-a, --disc|-d N] "Movie Name (Year)" [min_seconds, default 3600]'
    echo '  default: rip only the longest title'
    echo '  --disc N | -d N:   N defines which disc-drive to read [default 0]'
    echo '  --all    | -a  :   rip every title longer than min_seconds'
    return 1
  fi

  local name=$1 min=${2:-3600}
  local dir=~/Videos/Movies/"$name"
  local title=all
  local drive=$(makemkvcon -r info disc:9999 | grep DRV | awk -F, -v d="$disc" '$1 == "DRV:" d {
    gsub(/"/, "", $7);
    print $7;
    }')
  # check if $drive is empty
  if [[ -z $drive ]]; then
    echo "no drive found with disc id: $disc"
    return 1
  fi
  echo "ripping disc:$disc in drive:$drive"

  if ((!all)); then
    echo "Scanning disc for the longest title..."
    title=$(makemkvcon -r info disc:$disc --minlength="$min" | awk -F, '
      /^TINFO:/ && $2 == 9 {
        id = substr($1, 7); d = $4; gsub(/"/, "", d)
        n = split(d, t, ":"); s = t[n] + t[n-1]*60 + (n > 2 ? t[n-2]*3600 : 0)
        if (s > max) { max = s; best = id }
      }
      END { if (best != "") print best }')
    if [[ -z $title ]]; then
      echo "rip: no title longer than $min seconds found"
      return 1
    fi
    echo "Ripping title $title"
  fi

  mkdir -p "$dir"
  makemkvcon --progress=-same mkv disc:$disc "$title" "$dir" --minlength="$min" || return 1

  local files=("$dir"/*_t*.mkv)
  if ((${#files[@]} == 1)) && [[ -e ${files[0]} ]]; then
    mv -n "${files[0]}" "$dir/$name.mkv"
  else
    echo "rip: ${#files[@]} files ripped, rename manually in $dir"
  fi

  eject "$drive"
}

detect_drive() {
  makemkvcon -r info disc:9999 | grep DRV | awk -F, '{print $1, $5, $6, $7}'
}
